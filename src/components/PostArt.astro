---
import { Image } from 'astro:assets';
import type { Writing } from '~/lib/writings';
interface Props {
  art: NonNullable<Writing['data']['art']>;
}
const { art } = Astro.props;
---

<figure class="plate">
  <Image
    src={art.src}
    alt={art.alt}
    widths={[480, 800, 1200, 1600]}
    sizes="(max-width: 760px) 100vw, (max-width: 1440px) 92vw, 1312px"
    loading="eager"
    fetchpriority="high"
  />
  <figcaption>
    <cite>{art.title}</cite>
    {art.credit && <> / {art.href ? <a href={art.href}>{art.credit}</a> : art.credit}</>}
  </figcaption>
</figure>
<style>
  .plate {
    max-width: var(--sp-wrap);
    margin: auto;
    padding-inline: var(--sp-gutter);
  }
  .plate :global(img) {
    width: 100%;
    height: auto;
  }
  figcaption {
    font: 11px/1.5 var(--font-mono);
    color: var(--sp-on-paper-tertiary);
    margin-top: 12px;
  }
  cite {
    font-style: normal;
  }
  @media (max-width: 760px) {
    .plate {
      padding-inline: 0;
    }
    figcaption {
      padding-inline: var(--sp-gutter);
      font-size: 10px;
    }
  }
</style>
