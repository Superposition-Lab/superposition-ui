---
import { SITE } from '~/config';
---

<footer class="site-footer">
  <div class="footer-top">
    <p>Questions are a good place to start.</p>
    <a href={`mailto:${SITE.email}`}>{SITE.email} <span aria-hidden="true">↗</span></a>
  </div>
  <div class="footer-bottom">
    <p class="copyright">© {SITE.foundedYear} {SITE.name}</p>
    <p>Quantum computing &amp; cryptography</p>
    <nav aria-label="External links">
      <a href="/rss.xml">RSS <span aria-hidden="true">↗</span></a>
      <a href={SITE.github}>GitHub <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</footer>
<style>
  .site-footer {
    padding: 52px var(--sp-gutter) 28px;
    max-width: var(--sp-wrap);
    margin: auto;
    width: 100%;
  }
  p {
    margin: 0;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--color-divider);
    font-size: 28px;
    line-height: 1.3;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding-top: 24px;
    color: var(--sp-on-paper-secondary);
    font-size: 14px;
  }
  .copyright {
    font: 12px/1.5 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  nav {
    display: flex;
    gap: 24px;
  }
  @media (max-width: 760px) {
    .site-footer {
      padding-block: 36px 28px;
    }
    .footer-top {
      flex-direction: column;
      gap: 16px;
      font-size: 26px;
      padding-bottom: 30px;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 16px;
      padding-top: 26px;
    }
  }
</style>
