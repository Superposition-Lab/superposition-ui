---
import { NAV_LINKS, SITE } from '~/config';
import LogoMark from './LogoMark.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="masthead">
  <a class="brand" href="/" aria-label={`${SITE.name} home`}>
    <LogoMark on="paper" /><span>{SITE.name}</span>
  </a>
  <nav aria-label="Primary">
    {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
    <a class="contact" href={`mailto:${SITE.email}`}
      >Get in touch <span aria-hidden="true">↗</span></a
    >
    <ThemeToggle />
  </nav>
</header>
<style>
  .masthead {
    min-height: 96px;
    padding: 0 var(--sp-gutter);
    max-width: var(--sp-wrap);
    margin: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    color: var(--color-accent);
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 28px;
    font-weight: 600;
    white-space: nowrap;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 46px;
  }
  nav a {
    font: 12px/1.5 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 14px 0;
  }
  @media (max-width: 1100px) {
    nav {
      gap: 24px;
    }
  }
  @media (max-width: 760px) {
    .masthead {
      min-height: 80px;
      gap: 16px;
    }
    .brand {
      font-size: 23px;
      gap: 8px;
    }
    nav {
      gap: 12px;
    }
    nav a {
      font-size: 10px;
    }
    .contact {
      display: none;
    }
  }
  @media (max-width: 600px) {
    nav a:nth-child(2) {
      display: none;
    }
  }
  @media (max-width: 380px) {
    .masthead {
      gap: 8px;
    }
    .brand {
      font-size: 20px;
    }
    nav {
      gap: 6px;
    }
    nav a {
      font-size: 9px;
    }
  }
</style>
