---
import LabSection from '~/components/LabSection.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteNav from '~/components/SiteNav.astro';
import WritingsList from '~/components/WritingsList.astro';
import Wrap from '~/components/Wrap.astro';
import Hero from '~/components/hero/Hero.astro';
import { SITE } from '~/config';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getWritings } from '~/lib/writings';
const writings = await getWritings();
---

<BaseLayout title={SITE.title} description={SITE.description} ogImage="/og/index.png">
  <SiteNav />
  <main id="main">
    <Hero />
    <Wrap><WritingsList writings={writings} /></Wrap>
    <LabSection />
  </main>
  <SiteFooter />
</BaseLayout>
