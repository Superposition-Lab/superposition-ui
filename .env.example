# Analytics is opt-in. With no provider set, the site ships no tracking script.
# Both supported providers are cookieless and need no consent banner.
#
#   plausible  -> PUBLIC_ANALYTICS_ID is your site domain, e.g. superposition.pages.dev
#   cloudflare -> PUBLIC_ANALYTICS_ID is your Web Analytics token
#
# Validated at build time by the schema in astro.config.ts.

PUBLIC_ANALYTICS_PROVIDER=none
# PUBLIC_ANALYTICS_ID=
